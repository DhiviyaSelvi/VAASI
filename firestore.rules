rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default rule: Deny everything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. users/{uid} collection (Public Seller Info & Ratings)
    match /users/{uid} {
      // Anyone can read public profile fields (seller name, college, locality, ratings on BookDetail)
      allow read: if true;

      // Only account owner can create profile; trust fields must start unverified/zero if supplied
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('collegeEmailVerified' in request.resource.data) || request.resource.data.collegeEmailVerified == false)
                    && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
                    && (!('ratingAverage' in request.resource.data) || request.resource.data.ratingAverage == 0);

      // Only account owner can update profile; trust fields cannot be modified from client
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'ratingAverage', 'ratingCount', 'collegeEmailVerified', 
                      'fulfilledPercent', 'avgResponseMins', 'memberSince'
                    ]);

      // Client-side deletion of user documents is prohibited
      allow delete: if false;

      // Private subcollection for sensitive info (e.g. user email)
      match /private/info {
        // Only the account owner can read or write their private info
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 2. listings/{listingId} collection
    match /listings/{listingId} {
      // Public read access allows unsigned users to browse book listings
      allow read: if true;

      // Signed-in users can create listings; sellerId must match auth UID, status must be 'available', title non-empty string, price number > 0, condition valid
      allow create: if request.auth != null 
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.status == 'available'
                    && request.resource.data.title is string 
                    && request.resource.data.title.size() > 0
                    && request.resource.data.price is number 
                    && request.resource.data.price > 0
                    && request.resource.data.condition in ['like_new', 'good', 'fair', 'well_read'];

      // Only the listing seller can update details; sellerId cannot be changed; title, price, condition, and status must remain valid
      allow update: if request.auth != null 
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.status in ['available', 'reserved', 'sold']
                    && request.resource.data.title is string 
                    && request.resource.data.title.size() > 0
                    && request.resource.data.price is number 
                    && request.resource.data.price > 0
                    && request.resource.data.condition in ['like_new', 'good', 'fair', 'well_read'];

      // Only the listing seller can delete the listing
      allow delete: if request.auth != null 
                    && resource.data.sellerId == request.auth.uid;
    }

    // 3. conversations/{convId} collection
    match /conversations/{convId} {
      // Only active participants can read the conversation
      allow read: if request.auth != null 
                  && request.auth.uid in resource.data.participantIds;

      // Creator must be in participantIds and there must be exactly 2 participants
      allow create: if request.auth != null 
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;

      // Only participants can update; listingId and participantIds array cannot be altered
      allow update: if request.auth != null 
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.listingId == resource.data.listingId
                    && request.resource.data.participantIds == resource.data.participantIds;

      // Only conversation participants can delete the conversation document
      allow delete: if request.auth != null 
                    && request.auth.uid in resource.data.participantIds;

      // 4. conversations/{convId}/messages/{msgId} subcollection
      match /messages/{msgId} {
        // Only participants of the parent conversation can read messages
        allow read: if request.auth != null 
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;

        // Only participants can send messages; senderId must match auth UID; type must be valid; if offer, amount > 0
        allow create: if request.auth != null 
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.type in ['text', 'offer', 'match']
                      && (request.resource.data.type != 'offer' || (request.resource.data.amount is number && request.resource.data.amount > 0))
                      && (request.resource.data.type != 'offer' || request.resource.data.status == 'pending')
                      && (request.resource.data.type != 'match' || request.resource.data.status == 'proposed')
                      && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000));

        // Updates: only allow changing 'status' field through valid state transitions
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (
            (resource.data.type == 'offer' && resource.data.status == 'pending'
              && request.resource.data.status == 'accepted'
              && request.auth.uid != resource.data.senderId)
            || (resource.data.type == 'match' && resource.data.status == 'proposed'
              && request.resource.data.status == 'agreed'
              && request.auth.uid != resource.data.senderId)
            || (resource.data.type == 'match' && resource.data.status == 'agreed'
              && request.resource.data.status == 'paid')
          );

        // Only conversation participants can delete message documents
        allow delete: if request.auth != null 
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
      }
    }
  }
}
